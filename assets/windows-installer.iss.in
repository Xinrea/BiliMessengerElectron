; Generated by CMake. Compile with Inno Setup 6, defining SourceDir and OutputDir.
; Both Windows release formats use the same statically linked executable.
[Setup]
AppId={{8B1C8058-CDA2-48BB-AF51-78ED085D0DB1}
AppName=BiliMessenger
AppVersion=@BM_VERSION@
VersionInfoVersion=@PROJECT_VERSION@
AppPublisher=Xinrea
AppPublisherURL=https://github.com/powerlive-io/bili-messenger
DefaultDirName={localappdata}\Programs\BiliMessenger
DefaultGroupName=BiliMessenger
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
OutputDir={#OutputDir}
OutputBaseFilename=BiliMessenger-Windows-x64-Setup
SetupIconFile=@CMAKE_CURRENT_SOURCE_DIR@/assets/icons/icon.ico
LicenseFile=@CMAKE_CURRENT_SOURCE_DIR@/LICENSE
UninstallDisplayIcon={app}\BiliMessenger.exe
Compression=lzma2
SolidCompression=yes
WizardStyle=modern

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "{#SourceDir}\BiliMessenger.exe"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{group}\BiliMessenger"; Filename: "{app}\BiliMessenger.exe"
Name: "{autodesktop}\BiliMessenger"; Filename: "{app}\BiliMessenger.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\BiliMessenger.exe"; Description: "{cm:LaunchProgram,BiliMessenger}"; Flags: nowait postinstall skipifsilent

; User data in %APPDATA%\bilimessenger is intentionally retained on uninstall.
